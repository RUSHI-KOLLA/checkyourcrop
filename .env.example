# Local development settings
# Copy to .env and fill in values

# Model resolution: local path takes precedence over HF Hub
MODEL_PATH=models/best.pt

# Hugging Face Hub model registry (used if MODEL_PATH not found)
MODEL_REPO=YOURNAME/checkyourcrop-model
MODEL_FILENAME=best.pt
MODEL_REVISION=main

# Server
HOST=0.0.0.0
PORT=7860

# Upload limits
MAX_UPLOAD_MB=10

# Rate limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Inference thresholds
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Device (cpu or cuda)
DEVICE=cpu

# Hugging Face token (for register/deploy stages)
# HF_TOKEN=hf_xxxxxxxxxxxx

# HF Model repo for register stage
# HF_MODEL_REPO=YOURNAME/checkyourcrop-model

# HF Space for deploy stage
# HF_SPACE=YOURNAME/checkyourcrop

# Deployed service URL for smoke test
# SERVICE_URL=https://YOURNAME-checkyourcrop.hf.space